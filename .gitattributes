# 统一换行，避免跨平台 diff 噪声
* text=auto eol=lf

# 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# 产物：diff 时视为生成物，折叠显示
demo/office-demo.html          linguist-generated=true
demo/office-demo-single.html   linguist-generated=true
assets/*.png                   linguist-documentation=false
